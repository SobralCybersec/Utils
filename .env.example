# File Organizer - Configuração de IA
# Copie este arquivo para .env e configure suas chaves

# ============================================
# PROVEDOR DE IA
# ============================================
# Opções: LOCAL, OPENAI, GEMINI, CUSTOM
AI_PROVIDER=LOCAL

# ============================================
# OPENAI (GPT-3.5/4)
# ============================================
# Obtenha sua chave em: https://platform.openai.com/api-keys
# Custo: ~$0.002 por 1000 arquivos (GPT-3.5)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# ============================================
# GOOGLE GEMINI (GRATUITO)
# ============================================
# Obtenha sua chave em: https://makersuite.google.com/app/apikey
# Limite: 60 requisições por minuto
GEMINI_API_KEY=

# ============================================
# ENDPOINT CUSTOMIZADO
# ============================================
# Use com gpt4free, Ollama, LocalAI, etc
# Exemplo gpt4free: http://localhost:1337/v1/chat/completions
# Exemplo Ollama: http://localhost:11434/v1/chat/completions
CUSTOM_ENDPOINT=http://localhost:1337/v1/chat/completions
CUSTOM_API_KEY=

# ============================================
# CONFIGURAÇÕES GERAIS
# ============================================
AUTO_BACKUP=false
LOG_LEVEL=INFO

# ============================================
# INSTRUÇÕES
# ============================================
# 1. Copie este arquivo para .env
# 2. Escolha um provedor (AI_PROVIDER)
# 3. Configure a API Key correspondente
# 4. Salve o arquivo
# 5. Reinicie o File Organizer

# IMPORTANTE:
# - Nunca compartilhe suas API Keys
# - Adicione .env ao .gitignore
# - Use variáveis de ambiente em produção
